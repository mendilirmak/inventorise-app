# Copy to .env and replace every value: cp .env.example .env
# .env is in .gitignore — never commit it.

APP_ENV=dev
LOG_LEVEL=INFO
LOW_STOCK_THRESHOLD=10

# At least 32 characters or the app refuses to start. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me

# Used by the postgres container AND to build DATABASE_URL in
# docker-compose.yml. Letters and digits only in the password, because it
# is placed inside a URL.
POSTGRES_USER=inventory
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=inventory
